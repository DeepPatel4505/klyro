generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TransactionType {
  CREDIT
  DEBIT
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  ledgers       Ledger[]
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Indexes
  @@index([userId])
}

model Ledger {
  id              String   @id @default(uuid())
  userId          String
  name            String
  currency        String
  opening_balance Decimal  @db.Decimal(precision: 19, scale: 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  transactions Transaction[]
  user         User          @relation(fields: [userId], references: [id])

  // Indexes
  @@index([userId])
}

model Transaction {
  id              String          @id @default(uuid())
  ledgerId        String
  type            TransactionType
  amount          Decimal         @db.Decimal(precision: 19, scale: 2)
  description     String
  note            String?
  balanceAfter    Decimal         @db.Decimal(precision: 19, scale: 2)
  transactionDate DateTime        @default(now())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relations
  ledger Ledger @relation(fields: [ledgerId], references: [id])

  // Indexes
  @@index([ledgerId, transactionDate, id], name: "ledger_transaction_date_id_idx")
}
